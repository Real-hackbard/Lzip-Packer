+
+#define _SC_NPROCESSORS_ONLN   1
+#define _SC_THREAD_THREADS_MAX 2
+long sysconf( int flag )
+{
+  switch( flag )
+  {
+    case _SC_NPROCESSORS_ONLN:
+      {
+        SYSTEM_INFO si;
+        GetSystemInfo( &si );
+        return si.dwNumberOfProcessors;
+      }
+
+    case _SC_THREAD_THREADS_MAX:
+      return 32;
+  }
+
+  return 0;
+}
+#endif
